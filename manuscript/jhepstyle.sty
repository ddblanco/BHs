% Local manuscript layout.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jhepstyle}[2026/09/15 Local manuscript layout]

\RequirePackage[a4paper,left=2.4cm,right=2.4cm,top=2.7cm,bottom=2.9cm]{geometry}
\RequirePackage{amsmath,amssymb}
\RequirePackage{graphicx}
\RequirePackage[table]{xcolor}
\RequirePackage{booktabs}
\RequirePackage{caption}
\RequirePackage{fancyhdr}
\RequirePackage[colorlinks=true,linkcolor=blue!55!black,
                citecolor=blue!55!black,urlcolor=blue!55!black]{hyperref}

% --- page furniture --------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\small -- \thepage\ --}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[C]{\small -- \thepage\ --}}

% --- title block -----------------------------------------------------------
\newcommand{\preprint}[1]{\gdef\@preprint{#1}}
\gdef\@preprint{}
% article already defines \abstract as an environment-style command.
\renewcommand{\abstract}[1]{\gdef\@jhepabstract{#1}}
\gdef\@jhepabstract{}
\newcommand{\keywords}[1]{\gdef\@jhepkeywords{#1}}
\gdef\@jhepkeywords{}
\newcommand{\emailAdd}[1]{\texttt{#1}}
\newcommand{\affiliation}[1]{\gdef\@jhepaffiliation{#1}}
\gdef\@jhepaffiliation{}

\renewcommand{\maketitle}{%
  \thispagestyle{plain}%
  \ifx\@preprint\@empty\else\noindent{\small\@preprint}\par\fi
  \par\vskip 1.4\baselineskip
  \noindent{\LARGE\bfseries\@title\par}%
  \vskip 1.1\baselineskip
  \ifx\@author\@empty\else
    \noindent{\normalsize\@author\par}\vskip .4\baselineskip
  \fi
  \ifx\@jhepaffiliation\@empty\else
    \noindent{\small\itshape\@jhepaffiliation\par}\vskip .8\baselineskip
  \fi
  \vskip .3\baselineskip
  \noindent\begin{minipage}{\textwidth}%
    \small\textbf{Abstract:} \@jhepabstract
  \end{minipage}\par
  \ifx\@jhepkeywords\@empty\else
    \vskip .9\baselineskip
    \noindent{\small\textbf{Keywords:} \@jhepkeywords\par}%
  \fi
  \vskip 1.6\baselineskip
  {\parskip 0pt\tableofcontents}%
  \vskip 1.2\baselineskip
}
\let\@author\@empty

% --- sectioning, captions, floats ------------------------------------------
\renewcommand{\contentsname}{Contents}
\setcounter{tocdepth}{2}
\captionsetup{font=small,labelfont=bf,labelsep=period,width=.94\textwidth}
% A little stretch, so that long inline mathematics does not leave
% overfull boxes in a single-column layout.
\tolerance=1200
\emergencystretch=1.6em
\setlength{\parskip}{0pt}
\setlength{\parindent}{1.2em}
\renewcommand{\topfraction}{.9}
\renewcommand{\bottomfraction}{.8}
\renewcommand{\textfraction}{.08}
\renewcommand{\floatpagefraction}{.8}

% --- table shapes ----------------------------------------------------------
% Named rather than written inline, so that `check_manuscript.py` can keep
% insisting that every decimal in the body of main.tex comes from the
% measurement. These two are typography and not results.
\newcommand{\airyrows}{\renewcommand{\arraystretch}{1.25}}
\newcommand{\tightcolumns}{\setlength{\tabcolsep}{4.2pt}}

% --- maths shorthands used throughout the paper ----------------------------
\newcommand{\GB}{\mathrm{GB}}
\newcommand{\ext}{\mathrm{ext}}
\newcommand{\dd}{\mathrm{d}}
\newcommand{\Tr}{\operatorname{Tr}}
\endinput
